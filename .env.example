# ─── Neon Postgres ───────────────────────────────────────────────────────────
#
# These variables are auto-provisioned when you install the Neon integration
# via the Vercel Marketplace dashboard:
#   https://vercel.com/dashboard/<team>/stores → Add → Neon
#
# After connecting, pull them locally with:
#   vercel env pull .env.local
#
# Until then, paste your Neon connection strings from https://console.neon.tech.
#
# ─────────────────────────────────────────────────────────────────────────────

# Pooled connection (PgBouncer, -pooler host) — used by the app at runtime.
DATABASE_URL=postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Direct / unpooled connection — used by drizzle-kit migrations only.
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require
